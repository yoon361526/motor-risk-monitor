# ===== 비밀정보 (절대 커밋 금지) =====
# 실제 API 키는 .env 에만 넣는다 (이 파일은 깃허브에 안 올라감)
.env
.env.*
# 단, 실제 키가 없는 템플릿(.env.example)은 커밋 허용
!.env.example
*.key
secrets.*

# ===== Python 캐시/컴파일 =====
__pycache__/
*.py[cod]
*$py.class
*.so

# ===== 테스트/커버리지 =====
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# ===== 가상환경 =====
.venv/
venv/
env/
ENV/

# ===== 실행 산출물 (엔진/AI가 생성하는 결과물) =====
result.json
report.md
report.txt
result.txt

# ===== 데이터 (원본 CSV는 필요시 아래 주석 해제) =====
# data/
# *.csv

# ===== IDE / 에디터 =====
.vscode/
.idea/
*.swp
*.swo

# ===== OS =====
.DS_Store
Thumbs.db
desktop.ini

# Paderborn 원본과 재생성 가능한 특징 추출 결과
data/paderborn/raw/
data/paderborn/derived/

# Streamlit 배포에 필요한 활성 모델과 예제 4개만 허용한다.
!data/paderborn/raw/
data/paderborn/raw/*
!data/paderborn/raw/tuning/
data/paderborn/raw/tuning/*
!data/paderborn/raw/tuning/N09_M07_F10_K003_1.mat
!data/paderborn/raw/tuning/N09_M07_F10_K004_1.mat
!data/paderborn/raw/tuning/N09_M07_F10_KA04_1.mat
!data/paderborn/raw/tuning/N09_M07_F10_KI04_1.mat

!data/paderborn/derived/
data/paderborn/derived/*
!data/paderborn/derived/comparison/
data/paderborn/derived/comparison/*
!data/paderborn/derived/comparison/dataset_manifest.json
!data/paderborn/derived/deployed/
data/paderborn/derived/deployed/*
!data/paderborn/derived/deployed/active_selected_model.json
!data/paderborn/derived/deployed/d006850046ef19c3afe6/
data/paderborn/derived/deployed/d006850046ef19c3afe6/*
!data/paderborn/derived/deployed/d006850046ef19c3afe6/engine.joblib
!data/paderborn/derived/deployed/d006850046ef19c3afe6/model_metadata.json
!data/paderborn/derived/deployed/d006850046ef19c3afe6/tuning_metrics.json

# 개인 제출용 텍스트 보고서와 원본 확인·보관 자료는 로컬에 유지한다.
/docs/*-report-draft.txt
/docs/report-assets/
